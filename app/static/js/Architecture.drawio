                    <mxGeometry x="480" y="200" width="280" height="30" as="geometry"/>
                </mxCell>
                <mxCell id="os_s3" value="4. Build online users list&#xa;   _user_to_sids.keys()&#xa;   Fetch user objects from DB" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=12;" parent="1" vertex="1">

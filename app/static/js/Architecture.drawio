                <mxCell id="os_phase1" value="PHASE 1: C CONNECTS" style="text;html=1;align=center;verticalAlign=middle;resizable=0;points=[];autosize=1;strokeColor=none;fillColor=none;fontSize=14;fontStyle=3;fontColor=#27ae60;" parent="1" vertex="1">
                    <mxGeometry x="500" y="80" width="250" height="30" as="geometry"/>

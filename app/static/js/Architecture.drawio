                <mxCell id="os_a4" value="Broadcast to ALL" style="edgeStyle=orthogonalEdgeStyle;rounded=0;strokeWidth=2;strokeColor=#e74c3c;fontStyle=1;fontSize=11;" parent="1" source="os_s6" target="os_ab2" edge="1">
                    <mxGeometry relative="1" as="geometry"/>
                </mxCell>
                <mxCell id="os_ab2" value="10. socket-handlers.js&#xa;    - C is now offline&#xa;    - Re-render user list&#xa;    - Disable call button for C" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8d7da;strokeColor=#e74c3c;fontSize=12;" parent="1" vertex="1">
                    <mxGeometry x="950" y="550" width="280" height="60" as="geometry"/>
                </mxCell>
                <mxCell id="os_a5" value="emit(&quot;connected&quot;)" style="edgeStyle=orthogonalEdgeStyle;rounded=0;strokeWidth=2;strokeColor=#27ae60;fontStyle=1;fontSize=11;dashed=1;" parent="1" source="os_s2" target="os_c1" edge="1">
                    <mxGeometry relative="1" as="geometry"/>
                </mxCell>
                <mxCell id="os_c1" value="11. Receive &quot;connected&quot;&#xa;    Connection live" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=12;" parent="1" vertex="1">
                    <mxGeometry x="50" y="200" width="260" height="40" as="geometry"/>
                </mxCell>
            </root>
        </mxGraphModel>
    </diagram>

                <mxCell id="os_a3" value="disconnect" style="edgeStyle=orthogonalEdgeStyle;rounded=0;strokeWidth=2;strokeColor=#e74c3c;fontStyle=1;fontSize=11;" parent="1" source="os2_1" target="os_s5" edge="1">
                    <mxGeometry relative="1" as="geometry"/>
                </mxCell>
                <mxCell id="os_s5" value="8. handle_disconnect()&#xa;   _remove_connection()&#xa;   Remove SID from memory&#xa;   If no more SIDs → remove user" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8d7da;strokeColor=#e74c3c;fontSize=12;" parent="1" vertex="1">
                    <mxGeometry x="480" y="490" width="280" height="70" as="geometry"/>

                <mxCell id="os1_1" value="1. Opens chat page&#xa;   globals.js creates socket" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=12;" parent="1" vertex="1">

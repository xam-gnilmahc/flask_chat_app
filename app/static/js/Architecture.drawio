                    <mxGeometry x="960" y="350" width="320" height="50" as="geometry"/>
                </mxCell>
                <mxCell id="vc1_7" value="9. Show call overlay&#xa;   Start timer" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;" parent="1" vertex="1">
                    <mxGeometry x="60" y="460" width="320" height="40" as="geometry"/>
                </mxCell>
                <mxCell id="vc_phase2" value="PHASE 2: CALLEE ACCEPTS" style="text;html=1;align=center;verticalAlign=middle;resizable=0;points=[];autosize=1;strokeColor=none;fillColor=none;fontSize=14;fontStyle=3;fontColor=#8e44ad;" parent="1" vertex="1">
                    <mxGeometry x="1000" y="430" width="250" height="30" as="geometry"/>
                </mxCell>
                <mxCell id="vc_b2" value="10. User clicks Accept&#xa;    getUserMedia() → camera + mic" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=12;" parent="1" vertex="1">
                    <mxGeometry x="960" y="480" width="320" height="40" as="geometry"/>
                </mxCell>
                <mxCell id="vc_b3" value="11. new RTCPeerConnection()" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=12;" parent="1" vertex="1">
                    <mxGeometry x="960" y="540" width="320" height="30" as="geometry"/>
                </mxCell>
                <mxCell id="vc_b4" value="12. setRemoteDescription(offer)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=12;" parent="1" vertex="1">
                    <mxGeometry x="960" y="590" width="320" height="30" as="geometry"/>
                </mxCell>
                <mxCell id="vc_b5" value="13. createAnswer() → SDP Answer&#xa;    bumpBitrate() → 2500 kbps cap" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=12;" parent="1" vertex="1">
                    <mxGeometry x="960" y="640" width="320" height="40" as="geometry"/>
                </mxCell>
                <mxCell id="vc_b6" value="14. setLocalDescription(answer)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=12;" parent="1" vertex="1">
                    <mxGeometry x="960" y="700" width="320" height="30" as="geometry"/>
                </mxCell>
                <mxCell id="vc_b7" value="emit(&quot;call_answer&quot;,&#xa;{to_user_id, sdp})" style="edgeStyle=orthogonalEdgeStyle;rounded=0;strokeWidth=2;strokeColor=#8e44ad;fontStyle=1;fontSize=11;" parent="1" source="vc_b6" target="vc_s3" edge="1">
                    <mxGeometry relative="1" as="geometry"/>
                </mxCell>
                <mxCell id="vc_s3" value="15. handle_call_answer()&#xa;    Relay to Device A" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=12;" parent="1" vertex="1">
                    <mxGeometry x="530" y="660" width="280" height="40" as="geometry"/>
                </mxCell>
                <mxCell id="vc_s4" value="emit(&quot;call_answer&quot;)" style="edgeStyle=orthogonalEdgeStyle;rounded=0;strokeWidth=2;strokeColor=#27ae60;fontStyle=1;fontSize=11;" parent="1" source="vc_s3" target="vc_a2" edge="1">
                    <mxGeometry relative="1" as="geometry"/>
                </mxCell>
                <mxCell id="vc_a2" value="16. setRemoteDescription(answer)&#xa;    ICE checks begin" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=12;" parent="1" vertex="1">
                    <mxGeometry x="60" y="650" width="320" height="40" as="geometry"/>
                </mxCell>
                <mxCell id="vc_phase3" value="PHASE 3: ICE CANDIDATE EXCHANGE (parallel)" style="text;html=1;align=center;verticalAlign=middle;resizable=0;points=[];autosize=1;strokeColor=none;fillColor=none;fontSize=14;fontStyle=3;fontColor=#e67e22;" parent="1" vertex="1">
                    <mxGeometry x="450" y="740" width="450" height="30" as="geometry"/>
                </mxCell>
                <mxCell id="vc_ice1" value="17. Browser discovers&#xa;    ICE candidates&#xa;    (network paths)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=12;" parent="1" vertex="1">
                    <mxGeometry x="60" y="790" width="320" height="50" as="geometry"/>
                </mxCell>
                <mxCell id="vc_ice_a" value="emit(&quot;ice_candidate&quot;)" style="edgeStyle=orthogonalEdgeStyle;rounded=0;strokeWidth=2;strokeColor=#e67e22;fontStyle=1;fontSize=11;" parent="1" source="vc_ice1" target="vc_s5" edge="1">
                    <mxGeometry relative="1" as="geometry"/>
                </mxCell>
                <mxCell id="vc_s5" value="18. Relay ICE candidates&#xa;    between A and B" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=12;" parent="1" vertex="1">
                    <mxGeometry x="530" y="800" width="280" height="40" as="geometry"/>
                </mxCell>
                <mxCell id="vc_ice_b" value="emit(&quot;ice_candidate&quot;)" style="edgeStyle=orthogonalEdgeStyle;rounded=0;strokeWidth=2;strokeColor=#e67e22;fontStyle=1;fontSize=11;" parent="1" source="vc_b8" target="vc_s5" edge="1">
                    <mxGeometry relative="1" as="geometry"/>
                </mxCell>
                <mxCell id="vc_b8" value="19. Browser discovers&#xa;    ICE candidates" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=12;" parent="1" vertex="1">
                    <mxGeometry x="960" y="790" width="320" height="40" as="geometry"/>
                </mxCell>
                <mxCell id="vc_phase4" value="PHASE 4: DIRECT P2P CONNECTION" style="text;html=1;align=center;verticalAlign=middle;resizable=0;points=[];autosize=1;strokeColor=none;fillColor=none;fontSize=14;fontStyle=3;fontColor=#27ae60;" parent="1" vertex="1">
                    <mxGeometry x="500" y="870" width="350" height="30" as="geometry"/>
                </mxCell>
                <mxCell id="vc_p2p" value="═══════════ DIRECT P2P CONNECTION ═══════════&#xa;&#xa;Device A camera ──────────────▶ Device B sees A&#xa;Device A mic    ──────────────▶ Device B hears A&#xa;Device B camera ◀────────────── Device A sees B&#xa;Device B mic    ◀────────────── Device A hears B&#xa;&#xa;NO SERVER INVOLVED — direct peer-to-peer&#xa;Video + Audio flows directly between browsers" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#27ae6666;fontSize=12;fontStyle=1;strokeWidth=3;" parent="1" vertex="1">
                    <mxGeometry x="200" y="910" width="750" height="120" as="geometry"/>
                </mxCell>
                <mxCell id="vc_phase5" value="PHASE 5: END CALL" style="text;html=1;align=center;verticalAlign=middle;resizable=0;points=[];autosize=1;strokeColor=none;fillColor=none;fontSize=14;fontStyle=3;fontColor=#e74c3c;" parent="1" vertex="1">
                    <mxGeometry x="550" y="1060" width="200" height="30" as="geometry"/>
                </mxCell>
                <mxCell id="vc_end1" value="20. Click End Call&#xa;    pc.close() + stopStream" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8d7da;strokeColor=#e74c3c;fontSize=12;" parent="1" vertex="1">
                    <mxGeometry x="60" y="1100" width="320" height="40" as="geometry"/>
                </mxCell>
                <mxCell id="vc_end_a" value="emit(&quot;end_call&quot;)" style="edgeStyle=orthogonalEdgeStyle;rounded=0;strokeWidth=2;strokeColor=#e74c3c;fontStyle=1;fontSize=11;" parent="1" source="vc_end1" target="vc_s6" edge="1">
                    <mxGeometry relative="1" as="geometry"/>
                </mxCell>
                <mxCell id="vc_s6" value="21. handle_end_call()&#xa;    Relay as &quot;call_ended&quot;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8d7da;strokeColor=#e74c3c;fontSize=12;" parent="1" vertex="1">
                    <mxGeometry x="530" y="1100" width="280" height="40" as="geometry"/>
                </mxCell>
                <mxCell id="vc_end_b" value="emit(&quot;call_ended&quot;)" style="edgeStyle=orthogonalEdgeStyle;rounded=0;strokeWidth=2;strokeColor=#e74c3c;fontStyle=1;fontSize=11;" parent="1" source="vc_s6" target="vc_end2" edge="1">
                    <mxGeometry relative="1" as="geometry"/>
                </mxCell>
                <mxCell id="vc_end2" value="22. endCall()&#xa;    pc.close() + stopStream&#xa;    Hide overlay" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8d7da;strokeColor=#e74c3c;fontSize=12;" parent="1" vertex="1">
                    <mxGeometry x="960" y="1100" width="320" height="50" as="geometry"/>
                </mxCell>
            </root>
        </mxGraphModel>
    </diagram>
